    <defName>RimBabel_Settings</defName>
    <label>RimBabel</label>
    <description>Open RimBabel settings.</description>
    <workerClass>RimBabel.Game.MainButtonWorker_Settings</workerClass>
    <buttonVisible>false</buttonVisible>
    <validWithoutMap>true</validWithoutMap>
    <order>1000</order>
  </MainButtonDef>
</Defs>
