# Build intermediates.
# Directory.Build.props sends them outside the published folder: they must never end up in it,
# since the whole of Mod/ goes to the Workshop as it stands.
.build/
Source/obj/
Source/bin/
Tests/obj/
Tests/bin/

# Development environments
.vs/
.vscode/
.idea/
*.user

# System. Steam publishes Mod/ as it stands: an Explorer artifact there would reach the players.
Thumbs.db
desktop.ini
.DS_Store
*.ico

# Generated by RimWorld next to the PNG when the item is uploaded. Never authored.
*.dds

# Claude Code session worktrees and local settings.
.claude/

# Run evidence stays on disk only: reports, logs and captures weigh tens of megabytes.
# What is tracked is the text summary beside it, docs/runs/*.md.
Tests/Pickle/Evidence/
docs/runs/evidence/
pickle-reports-archive/
